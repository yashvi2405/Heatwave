# Copy this file to .env and fill in your own values

# MongoDB connection string (MongoDB Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/heatwave_db?retryWrites=true&w=majority

# Server settings
PORT=5000

# JWT secret used to sign login tokens (use any long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# Heatwave prediction threshold (in Celsius)
HEATWAVE_THRESHOLD=40
